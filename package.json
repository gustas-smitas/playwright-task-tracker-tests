{
  "name": "playwright-practice",
  "version": "1.0.0",
  "description": "A guided Playwright and TypeScript practice lab",
  "scripts": {
    "start": "node app/server.cjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui --ui-host=0.0.0.0 --ui-port=8080",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:solutions": "SOLUTIONS=1 playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "private": true
}
